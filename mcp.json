{
  "mcpServers": {
    "galaxia-api": {
      "command": "pnpm",
      "args": [
        "--dir",
        "mcp/galaxia-api",
        "exec",
        "node",
        "dist/index.js"
      ],
      "env": {
        "BASE_URL": "http://localhost:3000"
      }
    },
    "galaxia-db": {
      "command": "pnpm",
      "args": [
        "--dir",
        "mcp/galaxia-db",
        "exec",
        "node",
        "dist/index.js"
      ],
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/reviews_dev"
      }
    }
  }
}
